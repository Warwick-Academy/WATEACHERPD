# LMS URL - The URL where your LMS application is running
NEXT_PUBLIC_LMS_URL=http://localhost:3001

# App URL - The URL where your LMS application is accessible to users  
NEXT_PUBLIC_APP_URL=https://your-lms-domain.com

# These are configured for the LMS server, not the website.
ANTHROPIC_API_KEY=your_anthropic_api_key
AI_QUIZ_MODEL=claude-sonnet-5-5
